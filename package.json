{
  "name": "goplay",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "predev": "npm run build -w shared",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "eval:fast": "EVAL_FIXTURE=1 EVAL_REPLAY=1 tsx eval/harness/runner.ts --suite=first33",
    "eval:record": "EVAL_FIXTURE=1 EVAL_RECORD=1 tsx eval/harness/runner.ts --suite=first33",
    "eval:live": "EVAL_FIXTURE=1 EVAL_LIVE=1 tsx eval/harness/runner.ts --suite=first33 --live",
    "eval:ui": "tsx eval/harness/uiShot.ts",
    "eval:corpus": "tsx eval/tools/build-corpus.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0"
  }
}
