# 百炼 Managed Agent
DASHSCOPE_API_KEY=
BAILIAN_APP_ID=
BAILIAN_WORKSPACE_ID=
BAILIAN_ENVIRONMENT_ID=

# FlyAI 正式 API Key（缺失时搜索接口返回 503 FLYAI_NOT_CONFIGURED，不会回落共享试用通道）
FLYAI_API_KEY=

# 图片 OCR 批处理并发数（可选，Task #231；Task #322 默认 4 → 6）：默认 6，取值 1~8 的整数；
# 非法值回退默认并告警。多图来源（如小红书九图）调高可缩短整批 wall-clock。
# 默认 6 的压测依据（Task #318，eval/tools/perf-task318.ts）：九图并发 6 墙钟 63s、
# 9/9 成功、峰值并发 6、无限流/配额错误。
GUIDE_IMAGE_CONCURRENCY=

# FlyAI 装配搜索并发数（可选，Task #313）：默认 6，取值 1~8 的整数；
# 非法值回退默认并告警。攻略来源装配阶段各点位搜索并行执行（结果按条目原序装配），
# 调高可缩短装配段墙钟，仍受 ASSEMBLE_BUDGET_MS=120s 整体预算约束（服务端固定值）。
ASSEMBLE_CONCURRENCY=